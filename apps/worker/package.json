{
  "name": "@teamlogger/worker",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@teamlogger/shared": "*",
    "@aws-sdk/client-s3": "^3.550.0",
    "bullmq": "^5.5.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.3.2",
    "mongoose": "^8.2.3",
    "sharp": "^0.33.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.28",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "moduleNameMapper": {
      "^@teamlogger/shared$": "<rootDir>/../../packages/shared/src/index.ts"
    }
  }
}
